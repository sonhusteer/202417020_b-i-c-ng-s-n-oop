<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TitledPane?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.geometry.Insets?>

<!-- Lab 05 – Section 4: Painter FXML -->
<BorderPane prefWidth="640" prefHeight="480"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="hust.soict.dsai.javafx.PainterController">

    <padding>
        <Insets top="8" right="8" bottom="8" left="8"/>
    </padding>

    <!-- LEFT: tool panel -->
    <left>
        <VBox spacing="8" maxHeight="Infinity">
            <VBox.margin>
                <Insets right="8"/>
            </VBox.margin>

            <!-- Pen / Eraser toggle -->
            <TitledPane text="Tool" collapsible="false">
                <VBox spacing="6">
                    <padding>
                        <Insets top="6" left="6" right="6" bottom="6"/>
                    </padding>
                    <RadioButton fx:id="radioPen" text="Pen" selected="true">
                        <toggleGroup>
                            <ToggleGroup fx:id="toolGroup"/>
                        </toggleGroup>
                    </RadioButton>
                    <RadioButton fx:id="radioEraser" text="Eraser"
                                 toggleGroup="$toolGroup"/>
                </VBox>
            </TitledPane>

            <!-- Clear button -->
            <Button text="Clear"
                    maxWidth="Infinity"
                    onAction="#clearButtonPressed"/>
        </VBox>
    </left>

    <!-- CENTER: drawing canvas -->
    <center>
        <Pane fx:id="drawingAreaPane"
              style="-fx-background-color: white;"
              onMouseDragged="#drawingAreaMouseDragged"/>
    </center>

</BorderPane>
